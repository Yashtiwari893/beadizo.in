# ==============================================================================
# BEADIZO ENVIRONMENT CONFIGURATION
#
# Copy to `.env.local` and fill in. `.env.local` is git-ignored — never commit it.
# Variables prefixed with NEXT_PUBLIC_ are embedded in the browser bundle and are
# visible to every visitor. Everything else is server-only.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PUBLIC SUPABASE CREDENTIALS (safe for the browser bundle)
#    Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS — never prefix these with NEXT_PUBLIC_
# ------------------------------------------------------------------------------

# Master passkey for /admin. Minimum 12 characters; use a long random string.
# Generate one with:  openssl rand -base64 24
ADMIN_SECRET_KEY=

# Signs admin session cookies. MUST be at least 32 characters.
# The app refuses to issue sessions if this is missing or too short.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# Supabase service-role key. Bypasses RLS, used only by server routes after the
# admin session has been verified. Treat it like a database root password.
# Supabase Dashboard -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=
